Use VdfBase.pkg
Use DefaultPrinter.h.pkg

Class cDefaultPrinter Is A cObject
    Function DefaultPrinter Returns WString
        WString wsPrinterName
        Integer iBufferSize 
        Boolean bSuccess
        
        Move 0 To iBufferSize
        Move (WinAPI_GetDefaultPrinter (0, AddressOf (iBufferSize))) To bSuccess
        If (Not (bSuccess)) Begin
            Move (ZeroString (iBufferSize)) to wsPrinterName
            Move (WinAPI_GetDefaultPrinter (AddressOf (wsPrinterName), AddressOf (iBufferSize))) to bSuccess
        End
        
        Function_Return wsPrinterName
    End_Function

    Function ChangeDefaultPrinter WString wsPrinterName Returns Boolean
        Boolean bSuccess
        
        Move (WinAPI_SetDefaultPrinter (AddressOf (wsPrinterName))) to bSuccess
        
        Function_Return bSuccess
    End_Function
End_Class
